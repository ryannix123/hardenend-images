# =============================================================================
# Acme Insurance: web front end (Node.js 24) on UBI
#
# This file and Containerfile.hardened are identical except for the FROM line.
# There is no build stage because there is nothing to install: the service
# uses only what ships with Node.js.
#
# The base image is written out in full (no ARG) so that Dependabot can see
# it and open a pull request when a tag or digest moves.
#
# Nothing in this build runs as root.
# =============================================================================
FROM registry.access.redhat.com/ubi10/nodejs-24-minimal:latest
ARG BASE_LABEL="UBI 10"
# Build date of the base image, filled in by the pipeline. The site shows it so you
# can see a remediation land: an old date before, a recent one after.
ARG BASE_CREATED="unknown"

LABEL name="acme-insurance-web" \
      summary="Acme Insurance demo front end (Node.js 24)" \
      io.k8s.display-name="Acme Insurance web" \
      io.openshift.expose-services="8080:http"

ENV BASE_IMAGE="${BASE_LABEL}" \
    BASE_CREATED="${BASE_CREATED}" \
    NODE_ENV=production \
    PORT=8080

WORKDIR /app
COPY --chown=1001:0 --chmod=0644 package.json server.js ./
COPY --chown=1001:0 --chmod=0755 public ./public

USER 1001
EXPOSE 8080
# Exec form is mandatory: the hardened runtime has no shell to interpret a string.
ENTRYPOINT ["node", "server.js"]
